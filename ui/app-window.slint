import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ElevatedButton, TextButton } from "../material-1.1.0/material.slint";
export component AppWindow inherits Window {
    title: "Hypr Center";
    width: 720px;
    height: 360px;

    in-out property <int> counter: 42;
    callback request-increase-value();

    VerticalBox {

        HorizontalBox {
            ElevatedButton {
                
                width: 120px;
                height: 50px;
                text: "btn";
                
            }

            TextButton {
                text: "hello";
                
            }

        }
        
        Text {
            text: "Counter: \{root.counter}";
        }

        Button {
            text: "Increase value";
            clicked => {
                root.request-increase-value();
            }
        }
    }
}
